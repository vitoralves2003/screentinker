<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher owns the shape, we own the layers. The legacy
     mipmap-*/ic_launcher.png files are still shipped for the Android 7 panels below API 26. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the system tints this silhouette to the wallpaper palette. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
