# Loop OS production environment — copy to .env beside docker-compose.prod.yml and fill in.
#
#   cp deploy/env.production.template .env && chmod 600 .env
#
# .env is gitignored AND excluded from the image (.dockerignore), so secrets never reach the
# repository or a built layer. docker-compose.prod.yml loads it with env_file.
#
# Full documentation of every option lives in .env.example at the repo root; this file is only
# what a Loop OS production deployment actually sets.

# --- identity ---------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://player.loopplayer.com.br

# Signing key for session tokens. GENERATE ONE — do not reuse this line as-is:
#   openssl rand -hex 64
# If left unset the app generates one under /data/certs and persists it, which also works;
# setting it explicitly means the sessions survive a volume being rebuilt.
JWT_SECRET=

# --- SaaS mode --------------------------------------------------------------------------
# false = the real multi-tenant product: plan bands, feature gates and billing are ENFORCED.
# true would bypass every plan gate and disable billing (single-tenant self-host mode).
SELF_HOSTED=false

# The first account to register becomes platform_admin regardless of this setting, but it
# lands on a 14-day Premium trial like any other signup. Grant yourself the top plan after
# registering — see DEPLOY.md, step 7.

# --- billing (Asaas) --------------------------------------------------------------------
BILLING_PROVIDER=asaas

# SANDBOX. Point at https://api.asaas.com/v3 only after the whole flow is validated —
# a production key issues real Pix/boleto/card charges the moment someone subscribes.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Asaas panel > Integrações > API. Leave EMPTY to run without billing: screens can still be
# added and removed, they simply are not re-priced. Nothing breaks.
ASAAS_API_KEY=

# Static token Asaas echoes in the asaas-access-token header on every webhook delivery. Set
# the SAME value here and in the Asaas webhook configuration (URL:
# https://player.loopplayer.com.br/api/asaas/webhook). Generate with:
#   openssl rand -hex 32
# EMPTY means the endpoint refuses every delivery (503) rather than trusting unsigned
# payment events — that is deliberate, not a bug.
ASAAS_WEBHOOK_TOKEN=

# --- media ------------------------------------------------------------------------------
# Upload ceiling. Must stay <= nginx's client_max_body_size or nginx 413s first.
MAX_FILE_SIZE=500MB

# Compression is on by default (1080p / H.264 / AAC for video, JPEG q80 for images) and needs
# no configuration; ffmpeg ships in the image. Uncomment to store originals untouched.
# MEDIA_COMPRESSION=false

# --- optional ---------------------------------------------------------------------------
# Email. With no transport configured, signup verification is skipped rather than stranding
# accounts — fine for a first deployment. Set these when you want verification + invites.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Loop OS <nao-responda@loopplayer.com.br>"

# Close public signup once your accounts are provisioned by hand.
# DISABLE_REGISTRATION=true
