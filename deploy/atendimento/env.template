# O .env DO ATENDIMENTO. Copie para /opt/atendimento/.env e preencha.
#
# NENHUM VALOR REAL ENTRA NESTE ARQUIVO -- ele é versionado. Os segredos nascem na máquina,
# com `openssl`, e ficam só no .env de lá (chmod 600).
#
# ATENÇÃO AO CIFRÃO: o docker compose INTERPOLA o env_file. Uma senha contendo `$` vira
# variável vazia e o serviço sobe sem senha nenhuma, calado. Por isso os segredos abaixo são
# gerados em hexadecimal, que não tem `$`.

# ── IDENTIDADE DA INSTALAÇÃO ───────────────────────────────────────────────────────────
SECRET_KEY_BASE=                 # openssl rand -hex 64
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ── O ENDEREÇO ─────────────────────────────────────────────────────────────────────────
# É daqui que saem os links dos e-mails e o endereço do balão de conversa. Se estiver
# errado, tudo funciona na tela e os links que o cliente recebe apontam para o lugar errado
# -- uma falha que só aparece do lado de quem recebeu.
FRONTEND_URL=https://ajuda.loopplayer.com.br
FORCE_SSL=false                  # o TLS termina no nginx do host, não aqui
DEFAULT_LOCALE=pt_BR

# ── BANCO ──────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=atendimento
POSTGRES_PASSWORD=               # openssl rand -hex 24

# ── CACHE E FILA ───────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                  # openssl rand -hex 24
REDIS_URL=redis://:SENHA_DO_REDIS@redis:6379
# A fila do Sidekiq mora no mesmo Redis, em outro banco lógico.
REDIS_SENTINELS=

# ── QUEM PODE CRIAR CONTA ──────────────────────────────────────────────────────────────
# `false` fecha o cadastro público. Sem isto, QUALQUER pessoa que alcance o endereço abre
# uma conta de atendente dentro do nosso sistema de suporte.
ENABLE_ACCOUNT_SIGNUP=false

# ── E-MAIL (etapa seguinte) ────────────────────────────────────────────────────────────
# Enquanto estiver vazio, o Chatwoot abre e atende normalmente e NÃO manda e-mail nenhum --
# inclusive o de convite de atendente. O primeiro usuário é criado por linha de comando.
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# ── ANEXOS (etapa seguinte) ────────────────────────────────────────────────────────────
# Vazio = os anexos ficam no volume da máquina. Quando o R2 entrar, é aqui.
ACTIVE_STORAGE_SERVICE=local
